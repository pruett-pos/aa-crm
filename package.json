{
  "name": "aa-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "node --experimental-strip-types scripts/setup-db.ts && next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "companycam:sync": "node --env-file=.env --experimental-strip-types scripts/companycam-sync.ts",
    "commission:backfill": "node --env-file=.env --experimental-strip-types scripts/backfill-commission.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "^16.3.8",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "prisma": "^7.10.0",
    "typescript": "^6.0.3"
  }
}
