DATABASE_URL=postgresql://user:pass@host:5432/aacrm
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
DEMANDIQ_WEBHOOK_SECRET=
PRUETT_POS_API_URL=https://pruetthis.app/api
PRUETT_POS_API_KEY=
APP_URL=http://localhost:3000
SESSION_SECRET=
RESEND_API_KEY=
EMAIL_FROM=A&A CRM <noreply@example.com>
DEV_ADMIN_EMAIL=
WEBSITE_FORM_SECRET=

# CompanyCam (photos), current public API. Create a Personal Access Token (Read & Write) in CompanyCam: Company Settings > Access Tokens (https://app.companycam.com/access-keys). It expires (we use 90 days), so renew it before then. Leave empty to run without it.
COMPANYCAM_ACCESS_TOKEN=
# Leave empty in production. Only tests and local fakes set this.
COMPANYCAM_API_BASE=

# Hover (measurements). Credentials come from Hover (integrations must be enabled on the account). Never commit them.
HOVER_CLIENT_ID=
HOVER_CLIENT_SECRET=
# Must match the redirect URL registered with Hover, like http://localhost:3000/api/hover/callback
HOVER_REDIRECT_URI=
# Leave empty in production. Only tests and local fakes set this.
HOVER_API_BASE=
# Encrypts stored integration tokens. 32 random bytes, base64. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_KEY=
