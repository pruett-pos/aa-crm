// Slice 1 models only (users + auth). db/schema.sql is the reference design;
// add models here as each later slice needs them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  csr
  estimator
  production_manager
  crew_leader
  accounting

  @@map("user_role")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  fullName      String   @map("full_name")
  email         String   @unique
  phone         String?
  role          UserRole
  ownTruck      Boolean  @default(false) @map("own_truck")
  preferredLang String   @default("en") @map("preferred_lang")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  loginTokens LoginToken[]
  sessions    Session[]

  @@map("users")
}

model LoginToken {
  tokenHash String    @id @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_tokens")
}

model Session {
  sessionHash String   @id @map("session_hash")
  userId      String   @map("user_id") @db.Uuid
  expiresAt   DateTime @map("expires_at") @db.Timestamptz()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum Division {
  roofing
  siding
  gutters
  windows_doors
  insulation
  spray_foam
  commercial

  @@map("division")
}

enum Market {
  west_plains
  springfield
  nw_arkansas

  @@map("market")
}

enum JobStage {
  new_lead
  appointment_set
  inspected
  contingency_signed
  claim_approved
  scope_presented
  contract_signed
  deposit_collected
  materials_ordered
  scheduled
  in_production
  closeout_punchlist
  invoiced
  depreciation_pending
  paid_in_full
  lost
  cancelled_after_approval

  @@map("job_stage")
}

enum PackageTier {
  good
  better
  best

  @@map("package_tier")
}

// Read-only slice of jobs: only the columns scope access checks need.
enum JobType {
  retail
  insurance
  condition_report

  @@map("job_type")
}

model Job {
  id                  String     @id @default(uuid()) @db.Uuid
  jobNumber           Int        @unique @default(autoincrement()) @map("job_number")
  jobType             JobType    @map("job_type")
  divisions           Division[]
  stage               JobStage
  estimatorId         String?    @map("estimator_id") @db.Uuid
  productionManagerId String?    @map("production_manager_id") @db.Uuid
  scopes              Scope[]

  @@map("jobs")
}

model DivisionManager {
  division Division
  market   Market
  userId   String   @map("user_id") @db.Uuid

  @@id([division, market])
  @@map("division_managers")
}

model Product {
  id           String  @id @default(uuid()) @db.Uuid
  pruettSku    String  @unique @map("pruett_sku")
  name         String
  unit         String
  retailCents  BigInt  @map("retail_cents")
  specialOrder Boolean @default(false) @map("special_order")
  items        ScopeItem[]

  @@map("products")
}

model Scope {
  id              String      @id @default(uuid()) @db.Uuid
  jobId           String      @map("job_id") @db.Uuid
  tier            PackageTier
  title           String
  saleCents       BigInt      @default(0) @map("sale_cents")
  costCents       BigInt      @default(0) @map("cost_cents")
  targetMarginBps Int         @default(4000) @map("target_margin_bps")
  selected        Boolean     @default(false)
  job             Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  items           ScopeItem[]

  @@unique([jobId, tier])
  @@map("scopes")
}

model ScopeItem {
  id             String   @id @default(uuid()) @db.Uuid
  scopeId        String   @map("scope_id") @db.Uuid
  kind           String   @default("material")
  sortOrder      Int      @default(0) @map("sort_order")
  productId      String?  @map("product_id") @db.Uuid
  description    String
  quantity       Decimal  @db.Decimal(12, 2)
  unitCostCents  BigInt   @map("unit_cost_cents")
  unitPriceCents BigInt   @map("unit_price_cents")
  color          String?
  scope          Scope    @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id])

  @@map("scope_items")
}
